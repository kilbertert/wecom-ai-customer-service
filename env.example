# ========================================
# 微信客服配置 (必需)
# ========================================

# 企业微信CorpID - 从企业微信管理后台获取
WECHAT_CORP_ID=wwe23eb3735710f8dc

# 企业微信Secret - 从企业微信管理后台获取
WECHAT_CORP_SECRET=vq8j5OtUETE4-aie8UqBla6O9hQ-9JGaWPLTQ91JB5I

# 微信客服Token - 自定义字符串，用于验证消息签名
WECHAT_KF_TOKEN=afmknsxUlGaQmboooxaFJJbN

# 微信客服EncodingAESKey - 自定义字符串，用于消息加密
WECHAT_ENCODING_AES_KEY=sPaNkClsCoROEPviXlWVmwtvAhpcDzwboCVivfaTqyl

# 回调URL基础地址 - 部署服务的域名
WECHAT_CALLBACK_BASE_URL=https://miguang.h5.qumall.qushiyun.com

# 指定客服ID (可选) - 只处理来自指定客服的消息
# 如果为空，则处理所有客服的消息
# WECHAT_ALLOWED_OPEN_KFID=kfc82c20e0d9c4d10a8

# ========================================
# Coze智能体配置 (必需)
# ========================================

# Coze API Token - 从Coze平台获取
COZE_API_TOKEN=pat_M3n0rbbNale0bXJOFuQ8Ld75p75002eSKqk8ZJEteRkkDCYCOtjXHy1KsDdMBW1t

# Coze工作流ID - 工作流发布后的ID（实际生效的是 COZE_BOT_ID，COZE_WORKFLOW_ID 仅作记录保留）
COZE_WORKFLOW_ID=7615498037791588402
COZE_BOT_ID=7615498037791588402


# Coze API基础URL - 国内站 api.coze.cn / 海外站 api.coze.com
COZE_API_BASE_URL=https://api.coze.cn

# ========================================
# Dify 智能体配置 (与 Coze 二选一,见 APP_AI_BACKEND)
# ========================================

# Dify API base — 国服/海外统一域名
DIFY_API_BASE=http://124.243.178.156:8501/v1

# Dify API Key — 形如 app-xxx
DIFY_API_KEY=app-UEcmUibDhaLn9QogsTrgAqEM

# Dify workflow 输入变量名 — 与工作流"开始"节点保持一致
# DIFY_INPUT_TEXT=input_text
# DIFY_INPUT_IMAGE=input_img_id
# DIFY_INPUT_AUDIO=input_audio_id

# Dify 强制要求的 end-user 标识(WeChat 场景下会用 external_userid 覆盖)
# DIFY_END_USER_DEFAULT=wechat-default-user

# Dify 工作流超时(秒) — Dify 较 Coze 慢,默认 120s
# DIFY_WORKFLOW_TIMEOUT=120

# Dify 工作流文本输出变量名 — workflow 结束节点里设置的变量
# DIFY_OUTPUT_TEXT=output

# Dify app 类型 — 决定走哪个 API 端点 (二选一)
#   workflow : /v1/workflows/run  (传统工作流, 结束节点声明 outputs)
#   chatflow : /v1/chat-messages  (advanced-chat / Chatflow, 响应扁平 answer)
# 默认 chatflow (新版 Dify 通用 chatflow 类型)
# DIFY_APP_MODE=chatflow

# Chatflow 专用超时 (秒) — 与 DIFY_WORKFLOW_TIMEOUT 区分
# DIFY_CHATFLOW_TIMEOUT=120

# Chatflow user_input_form select 字段 — 决定 chatflow 内 L1 板块路由。
# 部署级常量 (本实例服务哪种端类型/地域/语言); 留空=不传, Dify 用字段 default=""。
# 线上 charge_charging_v16 定义了这三个 select (见 GET /v1/parameters)。
# 逐消息可在 input_data 用 language/hint_endpoint/hint_region 覆盖 (见 _run_chatflow)。
# DIFY_CHATFLOW_INPUT_LANGUAGE=zh        # zh | en | vi
# DIFY_CHATFLOW_INPUT_HINT_ENDPOINT=user # user | butler | pc
# DIFY_CHATFLOW_INPUT_HINT_REGION=cn     # cn | overseas

# ========================================
# 应用配置 (可选)
# ========================================

# 应用密钥 - 用于安全签名，建议使用随机字符串
APP_SECRET_KEY=your_secret_key_here

# 调试模式 - 生产环境设为false
APP_DEBUG=false

# 服务器主机 - 0.0.0.0表示监听所有地址
APP_HOST=0.0.0.0

# 服务器端口
APP_PORT=8501

# AI 后端选择: "coze" (默认, 向后兼容) | "dify"
# 切换后需在对应小节 (上方 Coze / Dify) 填入对应凭据

# Bot 决策日志 (智能机器人可选功能) — 部署时按需切换
# 每次机器人回复后, 输出一条精简的"决策日志"消息, 展示本次回复经过的关键阶段
#   "off"      : 不输出 (默认, 对现有行为零侵入)
#   "inline"   : 把 trace 拼到 AI 回复末尾, 单次 POST, 协议最稳
#   "separate" : 主回复发出后, 再单独 POST 一次 trace 消息
#                 视觉上是两条消息, 依赖企业微信允许多次 aibot/response 推送
# APP_BOT_TRACE_MODE=off

# inline 模式下 trace 块最大字符数 (超出截断, 避免超 4KB markdown 限制)
# APP_BOT_TRACE_MAX_LEN=1500

# ========================================
# Chatwoot 集成 (Phase 1) - 可选
# ========================================
# Chatwoot base URL (即 Channel::Wecom.wecom_ai_service_url 的目标)
CHATWOOT_BASE_URL=http://chatwoot:3000

# 与 Channel::Wecom.wecom_ai_secret 一致的 HMAC 密钥
# CHATWOOT_HMAC_SECRET=replace_with_long_random_hex

# 是否启用 Chatwoot 同步 (默认 False, 不影响现有 wecom-ai 行为)
# CHATWOOT_ENABLED=false

# 调用 Chatwoot 的 HTTP 超时 (秒)
# CHATWOOT_REQUEST_TIMEOUT=10